{
  "$schema": "season-calendar.schema.json",
  "description": "季节跨度、现实节奏适配与忙碌季错峰配置",
  "version": "1.0.0",
  "paceModes": {
    "companion": {
      "label": "伴随模式",
      "realDaysPerGameDay": 1,
      "dayRolloverHour": 5,
      "description": "1 现实日 = 1 游戏日"
    },
    "manual": {
      "label": "手动模式",
      "realDaysPerGameDay": null,
      "description": "玩家点击「结束今日」推进"
    },
    "weekend": {
      "label": "周末模式",
      "freezeOnWeekdays": true,
      "description": "工作日游戏日冻结"
    }
  },
  "seasons": {
    "spring": {
      "gameDays": 14,
      "realDaysStandard": 14,
      "intensity": 3,
      "peakActions": ["reclaim", "plant"],
      "notes": "开荒播种，中等强度"
    },
    "summer": {
      "gameDays": 14,
      "realDaysStandard": 14,
      "intensity": 2,
      "peakActions": ["water", "maintain"],
      "notes": "维护为主，低强度"
    },
    "autumn": {
      "gameDays": 14,
      "realDaysStandard": 14,
      "intensity": 4,
      "peakActions": ["harvest", "sell"],
      "staggeredHarvest": {
        "week1Ratio": 0.3,
        "week2Ratio": 0.4,
        "week3Ratio": 0.3,
        "rushDayOnWeekend": true
      },
      "notes": "唯一 busy season，成熟错峰至周末"
    },
    "winter": {
      "gameDays": 10,
      "realDaysStandard": 10,
      "intensity": 1,
      "peakActions": ["craft", "trade", "plan"],
      "notes": "规划加工，低强度缓冲"
    }
  },
  "pacePresets": {
    "casual": {
      "seasonLengthScale": 0.75,
      "realDaysMultiplier": 1.5,
      "protectionCapRatio": 0.5,
      "label": "休闲"
    },
    "standard": {
      "seasonLengthScale": 1.0,
      "realDaysMultiplier": 1.0,
      "protectionCapRatio": 0.4,
      "label": "标准"
    },
    "hardcore": {
      "seasonLengthScale": 1.2,
      "realDaysMultiplier": 0.7,
      "protectionCapRatio": 0,
      "protectionEnabledDefault": false,
      "label": "硬核"
    }
  },
  "workProtection": {
    "enabledDefault": true,
    "defaultProtectedSlots": [
      { "days": [1, 2, 3, 4, 5], "start": "09:00", "end": "18:00" }
    ],
    "maxContinuousHours": 12,
    "maxFrozenRatioPerSeason": 0.4,
    "behaviors": {
      "seasonCountdown": "pause",
      "harvestWindow": "pause",
      "cropGrowth": "continue",
      "randomEvents": "queue"
    }
  },
  "harvestWindowAlignment": {
    "minEveningSlots": 2,
    "requireFullWeekend": true,
    "extendIfEndsInProtectedSlot": true,
    "rushDayPreferWeekend": true
  },
  "offlineFallback": {
    "queueEventsAfterHours": 48,
    "tripModeMaxDays": 5,
    "tripModePerSeason": 1,
    "newbieSeasonLossReduction": 0.5
  },
  "yearSummary": {
    "totalRealDaysStandard": 52,
    "busySeasons": ["autumn"],
    "maxConsecutiveBusySeasons": 1
  }
}
