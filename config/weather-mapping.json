{
  "$schema": "weather-mapping.schema.json",
  "description": "现实天气 → 游戏标签映射，用于随机事件权重修正",
  "version": "1.0.0",
  "mappings": [
    {
      "source": { "condition": ["clear", "sunny", "few_clouds"] },
      "gameTag": "clear",
      "eventWeightModifiers": {
        "drought": 1.4,
        "wildfire": 1.3,
        "crop_sun_bonus": 1.1,
        "flood": 0.6
      }
    },
    {
      "source": { "condition": ["clouds", "overcast"] },
      "gameTag": "cloudy",
      "eventWeightModifiers": {}
    },
    {
      "source": { "condition": ["drizzle", "rain", "light_rain"] },
      "gameTag": "rain",
      "eventWeightModifiers": {
        "flood": 1.2,
        "mold": 1.3,
        "crop_growth_bonus": 1.05,
        "wildlife_invasion": 0.8
      }
    },
    {
      "source": { "condition": ["thunderstorm", "heavy_rain"] },
      "gameTag": "storm",
      "eventWeightModifiers": {
        "flood": 1.8,
        "crop_lodging": 1.5,
        "wildlife_migration": 1.2
      }
    },
    {
      "source": { "condition": ["snow", "sleet"] },
      "gameTag": "snow",
      "eventWeightModifiers": {
        "frost": 1.6,
        "wildlife_invasion": 1.2,
        "small_animal_hide": 1.4
      }
    },
    {
      "source": { "condition": ["mist", "fog", "haze"] },
      "gameTag": "fog",
      "eventWeightModifiers": {
        "wildlife_invasion": 1.3,
        "precursor_detection_penalty": 1.2
      }
    },
    {
      "source": { "tempMin": 35 },
      "gameTag": "heatwave",
      "eventWeightModifiers": {
        "drought": 1.5,
        "stamina_drain": 1.1,
        "wildfire": 1.4
      }
    },
    {
      "source": { "windSpeedMin": 10 },
      "gameTag": "windy",
      "eventWeightModifiers": {
        "crop_lodging": 1.4,
        "fence_damage": 1.2,
        "bird_peck": 1.2
      }
    }
  ],
  "safeguards": {
    "maxSameTagEventsPerDay": 1,
    "maxStormEscalationDays": 3,
    "maxStormTier": 2,
    "cacheHours": 6
  }
}
